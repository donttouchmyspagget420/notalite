# App
SECRET_KEY=
UPLOAD_FOLDER=storage

# Mail configuration (flask-mailman)
MAIL_BACKEND=smtp
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=NotaLite <your-email@example.com>

# Google configuration
GOOGLE_CLIENT_ID= 
GOOGLE_CLIENT_SECRET= 

# Google Gemini (AI assistant in the note editor)
GOOGLE_LLM_API_KEY=
GOOGLE_LLM_MODEL=gemini-3.5-flash

# Image storage. Use STORAGE_BACKEND=local (default) or s3.
# For S3 (or any S3-compatible service such as MinIO/R2) fill the AWS block.
STORAGE_BACKEND=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=
AWS_S3_PREFIX=notalite
AWS_S3_PUBLIC_URL=
AWS_S3_ENDPOINT_URL=
AWS_S3_ACL=public-read

#db
SQLALCHEMY_DATABASE_URI=sqlite:///notalite.db
SQLALCHEMY_TRACK_MODIFICATIONS=True
